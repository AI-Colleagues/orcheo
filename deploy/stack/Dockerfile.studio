# Stage 1: Build the Studio app with placeholder values
FROM node:20-alpine AS build

ARG ORCHEO_RELEASE_CHANNEL=stable
ARG ORCHEO_STUDIO_VERSION=

WORKDIR /app

RUN case "$ORCHEO_RELEASE_CHANNEL" in \
      stable) studio_tag=latest ;; \
      prerelease) \
        if npm view orcheo-studio@prerelease version >/dev/null 2>&1; then \
          studio_tag=prerelease; \
        else \
          studio_tag=latest; \
        fi ;; \
      *) echo "Unsupported release channel: $ORCHEO_RELEASE_CHANNEL" >&2; exit 1 ;; \
    esac \
    && npm init -y \
    && if [ -n "$ORCHEO_STUDIO_VERSION" ]; then \
      npm install --silent "orcheo-studio@${ORCHEO_STUDIO_VERSION}"; \
    else \
      npm install --silent "orcheo-studio@${studio_tag}"; \
    fi

# Set placeholder values for all VITE_ vars so they get baked into the JS
# bundle. At container startup, an entrypoint script replaces these
# placeholders with real environment variable values.
ENV VITE_ORCHEO_BACKEND_URL=__VITE_ORCHEO_BACKEND_URL__ \
    VITE_ORCHEO_AUTH_DISABLED=__VITE_ORCHEO_AUTH_DISABLED__ \
    VITE_ORCHEO_APPS_BASE_DOMAIN=__VITE_ORCHEO_APPS_BASE_DOMAIN__ \
    VITE_ORCHEO_CHATKIT_DOMAIN_KEY=__VITE_ORCHEO_CHATKIT_DOMAIN_KEY__ \
    VITE_ORCHEO_ALLOWED_HOSTS=__VITE_ORCHEO_ALLOWED_HOSTS__ \
    VITE_ORCHEO_APPS_PORT=__VITE_ORCHEO_APPS_PORT__

RUN npm --prefix node_modules/orcheo-studio run build

# Stage 2: Serve with nginx
FROM nginx:alpine

RUN apk add --no-cache bash

# Copy the built assets
COPY --from=build /app/node_modules/orcheo-studio/dist /usr/share/nginx/html

# Copy nginx config and entrypoint
COPY nginx-studio.conf /etc/nginx/conf.d/default.conf
COPY studio-entrypoint.sh /docker-entrypoint.d/40-studio-env.sh
RUN chmod +x /docker-entrypoint.d/40-studio-env.sh

EXPOSE 2026
