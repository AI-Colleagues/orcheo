# -----------------------------------------------------------------------------
# Orcheo Stack Environment Template
#
# Notes:
# - This file is read by Docker Compose and injected into backend/worker/canvas.
# - `${VAR}` references below reuse earlier values to avoid duplication.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Required secrets and signing keys
# -----------------------------------------------------------------------------
# PostgreSQL password used by the `postgres` container and backend DSN.
ORCHEO_POSTGRES_PASSWORD=change-me
# 64-hex key used by the vault to encrypt credentials at rest.
ORCHEO_VAULT_ENCRYPTION_KEY=replace-with-64-hex-chars
# HMAC signing key used to mint/verify ChatKit access tokens.
ORCHEO_CHATKIT_TOKEN_SIGNING_KEY=strong-random-secret
# Bootstrap API token used when auth mode is `required` or `optional`.
ORCHEO_AUTH_BOOTSTRAP_SERVICE_TOKEN=change-me
# Public ChatKit domain key consumed by Canvas; required for ChatKit UI features.
# Security note: this value is shipped to browsers. Scope it per environment.
VITE_ORCHEO_CHATKIT_DOMAIN_KEY=domain_pk_replace_me
# HMAC secret used by the Credential Broker to sign run-scoped tokens issued
# to sandboxes. Backend refuses to start if unset — sandboxing is always on.
# Auto-generated by `orcheo install` on a fresh stack env file.
ORCHEO_CREDENTIAL_BROKER_SECRET=replace-with-broker-secret
# Internal bearer-equivalent secret sent only between backend/worker and the
# Docker-facing sandbox-runtime control app.
ORCHEO_SANDBOX_CONTROL_TOKEN=replace-with-sandbox-control-token

# -----------------------------------------------------------------------------
# Workspace runtime isolation (gVisor sandbox)
# -----------------------------------------------------------------------------
# Master switch for runtime sandboxing. `true` disables sandbox dispatch and
# agent-process sandboxing entirely; keep this `false` in stack deployments that
# should preserve workspace isolation.
ORCHEO_SANDBOX_DISABLED=false
# Internal URL of the sandbox-runtime service. Backend and worker call this
# to acquire per-workspace sandboxes and dispatch tenant workflow runs; they
# never mount the Docker socket themselves. See
# docs/operators/workspace_runtime_isolation.md.
ORCHEO_SANDBOX_RUNTIME_URL=http://sandbox-runtime:9090
# Container runtime the sandbox-runtime spawns sandboxes under. `runsc`
# selects gVisor and gives the documented isolation guarantees; `runc`
# is the stock Docker runtime and only suitable for local dev where
# gVisor is not installed. Production deployments MUST set this to
# `runsc` (and register the runtime with Docker first — see the operator
# guide).
#
# Defaults wired into the compose files:
#   - deploy/stack/docker-compose.yml (this env template)  → `runsc` (prod)
#   - deploy/stack/docker-compose.staging.yml overlay      → `runc`  (local builds, no gVisor)
#   - root docker-compose.yml (dev hot-reload stack)       → `runc`
# Override here only when this env file is used against a non-default host.
ORCHEO_CONTAINER_RUNTIME=runsc
# OCI image hosting agent CLIs, the Orcheo CLI, and the workflow runner.
# Published by CI to GHCR on `stack-v*` tags; sandbox-runtime pulls it on
# first use. Override to a locally-built tag if you build it from source.
ORCHEO_SANDBOX_IMAGE=ghcr.io/ai-colleagues/orcheo-workspace-sandbox:latest
# Global HTTP/HTTPS destination allowlist used when rendering the mounted
# Envoy configuration.
#
# Values:
#   *                       Allow every host. Sandboxes can reach any HTTP/HTTPS
#                           destination through the proxy. nftables, gVisor/runc,
#                           and the audit log still enforce network/host
#                           isolation — what you lose is host-level policy.
#                           Appropriate for single-tenant deployments where you
#                           trust all workflow code; NOT recommended for
#                           multi-tenant production (a compromised sandbox could
#                           exfiltrate to arbitrary domains).
#   host1.com,host2.com,…   Explicit allowlist. Required posture for multi-tenant
#                           production deployments.
#   (empty)                 Deny all external egress.
ORCHEO_SANDBOX_EGRESS_ALLOWED_HOSTS=*
# When `true`, workflows composed only of trusted built-in nodes skip the
# sandbox (faster cold-start). Vibe agents always run sandboxed regardless.
ORCHEO_SANDBOX_FAST_PATH_TRUSTED=false

# Sliding window (seconds) used to measure peak concurrent sandbox usage per
# workspace for warm-pool autoscaling. Workspaces with no usage within this
# window are not proactively prewarmed (they remain at pool size 0 until the
# next run, which may cold-provision). Default: 600 (10 minutes).
ORCHEO_SANDBOX_WARM_WINDOW_SECONDS=600

# Global cap on the total number of warm (READY) sandbox containers across all
# workspaces. Prevents memory pressure on the host if many workspaces are
# active simultaneously. 0 = unbounded (rely only on per-workspace pool_max).
# Default: 12.  Tune down if host memory is constrained; tune up on large hosts.
ORCHEO_SANDBOX_MAX_TOTAL_WARM=12

# -----------------------------------------------------------------------------
# Core service defaults (database, API, and browser-facing URLs)
# -----------------------------------------------------------------------------
# PostgreSQL username used by the `postgres` container and internal DSN.
ORCHEO_POSTGRES_USER=orcheo
# PostgreSQL database name used by backend/worker/celery-beat.
ORCHEO_POSTGRES_DB=orcheo
# PostgreSQL DSN used by the workspace repository and other postgres-backed stores.
ORCHEO_POSTGRES_DSN=postgresql://${ORCHEO_POSTGRES_USER}:${ORCHEO_POSTGRES_PASSWORD}@localhost:5432/${ORCHEO_POSTGRES_DB}
# Public backend API URL used by CLI/SDK integrations.
ORCHEO_API_URL=http://localhost:2025
# Canvas API base URL; typically same as ORCHEO_API_URL.
VITE_ORCHEO_BACKEND_URL=${ORCHEO_API_URL}
# Public Studio (Canvas) base URL used to generate share links from backend
# responses. `orcheo install` prompts for this after the backend URL.
ORCHEO_STUDIO_URL=http://localhost:2026
# CORS allow-list enforced by backend for browser API requests.
# `orcheo install` derives this from ORCHEO_STUDIO_URL plus localhost origins.
ORCHEO_CORS_ALLOW_ORIGINS=http://localhost:2026,http://127.0.0.1:2026
# Bundled ingress mode: `false` keeps the localhost-friendly install path.
ORCHEO_PUBLIC_INGRESS_ENABLED=false
# Public hostname served by bundled Caddy when ingress is enabled.
ORCHEO_PUBLIC_HOST=
# Compose profiles activated by `orcheo install`.
# Add `public-ingress` to enable bundled Caddy TLS ingress.
COMPOSE_PROFILES=
# Caddy site address; normally the same as ORCHEO_PUBLIC_HOST.
ORCHEO_CADDY_SITE_ADDRESS=
# Space-delimited backend upstreams for `/api/*` and `/ws/*` routing.
ORCHEO_CADDY_BACKEND_UPSTREAMS=backend:2025
# Internal Canvas upstream for `/` and SPA routing.
ORCHEO_CADDY_CANVAS_UPSTREAM=canvas:2026
# Optional bind addresses for the public ingress listener.
ORCHEO_CADDY_HTTP_BIND=0.0.0.0
ORCHEO_CADDY_HTTPS_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Backend authentication behavior (API token validation)
# -----------------------------------------------------------------------------
# Backend auth mode: `disabled`, `optional`, or `required`.
ORCHEO_AUTH_MODE=disabled
# Enables backend developer login endpoint when true (keep false in production).
ORCHEO_AUTH_DEV_LOGIN_ENABLED=false
# OIDC issuer expected in incoming JWTs (backend validation).
# e.g. https://your-auth-provider.com/
ORCHEO_AUTH_ISSUER=
# OAuth client ID (used by CLI OAuth login and shared with Canvas below).
ORCHEO_AUTH_CLIENT_ID=your-client-id
# JWT audience expected by backend token validation.
# e.g. https://your-api-audience.com
ORCHEO_AUTH_AUDIENCE=
# JWKS endpoint backend uses to fetch signing keys for JWT verification.
# e.g. https://your-auth-provider.com/.well-known/jwks.json
ORCHEO_AUTH_JWKS_URL=

# -----------------------------------------------------------------------------
# Canvas OAuth login configuration (browser-side)
# -----------------------------------------------------------------------------
# Leave blank to disable OAuth login UI; set to enable login page redirects.
# Usually the same as ORCHEO_AUTH_ISSUER; e.g. VITE_ORCHEO_AUTH_ISSUER=${ORCHEO_AUTH_ISSUER}
VITE_ORCHEO_AUTH_ISSUER=
# Canvas OAuth client ID; defaults to ORCHEO_AUTH_CLIENT_ID to avoid duplication.
VITE_ORCHEO_AUTH_CLIENT_ID=${ORCHEO_AUTH_CLIENT_ID}
# Optional explicit callback URL; blank uses `${origin}/auth/callback`.
VITE_ORCHEO_AUTH_REDIRECT_URI=
# Space-delimited scopes requested by Canvas during OAuth login.
VITE_ORCHEO_AUTH_SCOPES=openid profile email workflows:read workflows:execute chatkit:session
# Optional OAuth audience for Canvas token requests.
VITE_ORCHEO_AUTH_AUDIENCE=${ORCHEO_AUTH_AUDIENCE}
# Optional organization identifier for IdPs that support organization-scoped login.
VITE_ORCHEO_AUTH_ORGANIZATION=
# Optional provider hint query parameter key (e.g., `connection`).
VITE_ORCHEO_AUTH_PROVIDER_PARAM=connection
# Optional provider hint value for Google.
VITE_ORCHEO_AUTH_PROVIDER_GOOGLE=google-oauth2
# Optional provider hint value for GitHub.
VITE_ORCHEO_AUTH_PROVIDER_GITHUB=github
# Optional provider hint value for email/password login (Auth0 database connection name).
VITE_ORCHEO_AUTH_PROVIDER_EMAIL=Username-Password-Authentication
# Comma-separated hostnames Canvas accepts (localhost and reverse-proxy/custom domains).
# `orcheo install` adds the hostname from ORCHEO_STUDIO_URL here.
VITE_ORCHEO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Optional localhost port bindings
# -----------------------------------------------------------------------------
ORCHEO_BACKEND_LOCAL_PORT=2025
ORCHEO_CANVAS_LOCAL_PORT=2026
ORCHEO_POSTGRES_LOCAL_PORT=5432
ORCHEO_REDIS_LOCAL_PORT=6379

# -----------------------------------------------------------------------------
# Optional stack runtime pin
# -----------------------------------------------------------------------------
# Runtime image for backend/worker/celery-beat. Uncomment to pin a release.
# ORCHEO_STACK_IMAGE=ghcr.io/ai-colleagues/orcheo-stack:0.1.0
