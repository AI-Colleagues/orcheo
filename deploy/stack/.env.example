# -----------------------------------------------------------------------------
# Orcheo Stack Environment Template
#
# Notes:
# - This file is read by Docker Compose and injected into backend/worker/studio.
# - `${VAR}` references below reuse earlier values to avoid duplication.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Required secrets and signing keys
# -----------------------------------------------------------------------------
# PostgreSQL password used by the `postgres` container and backend DSN.
ORCHEO_POSTGRES_PASSWORD=change-me
# 64-hex key used by the vault to encrypt credentials at rest.
ORCHEO_VAULT_ENCRYPTION_KEY=replace-with-64-hex-chars
# HMAC signing key used to mint/verify ChatKit access tokens.
ORCHEO_CHATKIT_TOKEN_SIGNING_KEY=strong-random-secret
# Bootstrap API token used when auth mode is `required` or `optional`.
ORCHEO_AUTH_BOOTSTRAP_SERVICE_TOKEN=change-me
# Public ChatKit domain key consumed by Studio; optional — set it to your
# ChatKit domain key to enable ChatKit UI features (a placeholder is used when
# left unset). Security note: this value is shipped to browsers. Scope it per
# environment.
VITE_ORCHEO_CHATKIT_DOMAIN_KEY=domain_pk_replace_me
# HMAC secret used by the Credential Broker to sign run-scoped tokens.
# Auto-generated by `orcheo install` on a fresh stack env file.
ORCHEO_CREDENTIAL_BROKER_SECRET=replace-with-broker-secret

# -----------------------------------------------------------------------------
# Core service defaults (database, API, and browser-facing URLs)
# -----------------------------------------------------------------------------
# PostgreSQL username used by the `postgres` container and internal DSN.
ORCHEO_POSTGRES_USER=orcheo
# PostgreSQL database name used by backend/worker/celery-beat.
ORCHEO_POSTGRES_DB=orcheo
# PostgreSQL DSN used by the workspace repository and other postgres-backed stores.
ORCHEO_POSTGRES_DSN=postgresql://${ORCHEO_POSTGRES_USER}:${ORCHEO_POSTGRES_PASSWORD}@localhost:5432/${ORCHEO_POSTGRES_DB}
# Public backend API URL used by CLI/SDK integrations.
ORCHEO_API_URL=http://localhost:2025
# Studio API base URL; typically same as ORCHEO_API_URL.
VITE_ORCHEO_BACKEND_URL=${ORCHEO_API_URL}
# Public Studio base URL used to generate share links from backend
# responses. `orcheo install` prompts for this after the backend URL.
ORCHEO_STUDIO_URL=http://localhost:2026
# Base domain used for hosted app aliases (`<alias>.<base-domain>`).
ORCHEO_APPS_BASE_DOMAIN=beta.orcheo.cloud
# CORS allow-list enforced by backend for browser API requests.
# `orcheo install` derives this from ORCHEO_STUDIO_URL plus localhost origins.
ORCHEO_CORS_ALLOW_ORIGINS=http://localhost:2026,http://127.0.0.1:2026
# Bundled ingress mode: `false` keeps the localhost-friendly install path.
ORCHEO_PUBLIC_INGRESS_ENABLED=false
# Public hostname served by bundled Caddy when ingress is enabled.
ORCHEO_PUBLIC_HOST=
# Compose profiles activated by `orcheo install`.
# Add `public-ingress` to enable bundled Caddy TLS ingress.
COMPOSE_PROFILES=
# Caddy site address; normally the same as ORCHEO_PUBLIC_HOST.
ORCHEO_CADDY_SITE_ADDRESS=
# Space-delimited backend upstreams for `/api/*` and `/ws/*` routing.
ORCHEO_CADDY_BACKEND_UPSTREAMS=backend:2025
# Internal Studio upstream for `/` and SPA routing.
ORCHEO_CADDY_STUDIO_UPSTREAM=studio:2026
# Optional bind addresses for the public ingress listener.
ORCHEO_CADDY_HTTP_BIND=0.0.0.0
ORCHEO_CADDY_HTTPS_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Backend authentication (first-party passwordless email IdP)
# -----------------------------------------------------------------------------
# Backend auth mode: `disabled`, `optional`, or `required`.
ORCHEO_AUTH_MODE=disabled
# Enables backend developer login endpoint when true (keep false in production).
ORCHEO_AUTH_DEV_LOGIN_ENABLED=false
# Signing secret for first-party HS256 access tokens. REQUIRED when
# `ORCHEO_AUTH_MODE=required`. `orcheo install` auto-generates it for required
# auth stacks; otherwise generate a strong random value, e.g.
# `openssl rand -hex 32`.
ORCHEO_AUTH_JWT_SECRET=
# First-party token issuer; the backend accepts only this issuer.
ORCHEO_AUTH_ISSUER=https://auth.orcheo.cloud
# Audience embedded in first-party tokens and validated by the backend.
ORCHEO_AUTH_AUDIENCE=orcheo-api
# Access-token / challenge / session tuning (optional; sensible defaults shown).
ORCHEO_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
ORCHEO_AUTH_CHALLENGE_TTL_MINUTES=15
ORCHEO_AUTH_SESSION_TTL_DAYS=30
ORCHEO_AUTH_OTP_DIGITS=6
ORCHEO_AUTH_OTP_MAX_ATTEMPTS=5
# NOTE: the generic external-issuer JWKS path (ORCHEO_AUTH_JWKS_URL) remains in
# the code but is dormant — reserved for the future enterprise-SSO initiative.

# -----------------------------------------------------------------------------
# Transactional email (SMTP) — auth sign-in links/codes and workspace invites
# -----------------------------------------------------------------------------
# Leave ORCHEO_SMTP_HOST blank to log sign-in links/codes and invite links to
# the backend logs instead of delivering email (self-host/dev default).
ORCHEO_SMTP_HOST=
ORCHEO_SMTP_PORT=587
ORCHEO_SMTP_USERNAME=
ORCHEO_SMTP_PASSWORD=
# From-address for all transactional email; use a domain you control.
ORCHEO_SMTP_FROM_EMAIL=no-reply@orcheo.cloud
# Use STARTTLS for the SMTP connection (recommended).
ORCHEO_SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Studio login configuration (browser-side)
# -----------------------------------------------------------------------------
# Set to `true` to disable the Studio login gate entirely (self-host/dev with
# the backend running in AUTH_MODE=disabled). Leave unset/false in production so
# the first-party login screen is required.
VITE_ORCHEO_AUTH_DISABLED=true
# Comma-separated hostnames Studio accepts (localhost and reverse-proxy/custom domains).
# `orcheo install` adds the hostname from ORCHEO_STUDIO_URL here.
VITE_ORCHEO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Optional localhost port bindings
# -----------------------------------------------------------------------------
ORCHEO_BACKEND_LOCAL_PORT=2025
ORCHEO_STUDIO_LOCAL_PORT=2026
ORCHEO_POSTGRES_LOCAL_PORT=5432
ORCHEO_REDIS_LOCAL_PORT=6379

# -----------------------------------------------------------------------------
# Optional stack runtime pins
# -----------------------------------------------------------------------------
# `orcheo install` writes all three values together for versioned installs.
# Uncomment all three to pin a release manually.
# ORCHEO_STACK_VERSION=0.1.0
# ORCHEO_STACK_IMAGE=ghcr.io/ai-colleagues/orcheo-stack:0.1.0
# ORCHEO_STUDIO_IMAGE=ghcr.io/ai-colleagues/orcheo-studio:0.1.0
