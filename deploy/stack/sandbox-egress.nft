#!/usr/sbin/nft -f
#
# Apply after Docker creates the `sandbox0` bridge:
#   nft -f deploy/stack/sandbox-egress.nft
#
# Compose reserves 10.99.0.2 for credential-relay, 10.99.0.3 for the
# HTTP/HTTPS proxy, and allocates tenant sandboxes only from 10.99.0.128/25.

table inet orcheo_sandbox {
  chain forward {
    type filter hook forward priority -10; policy accept;

    iifname "sandbox0" ip saddr 10.99.0.128/25 ip daddr 10.99.0.2 tcp dport 9091 accept
    iifname "sandbox0" ip saddr 10.99.0.128/25 ip daddr 10.99.0.3 tcp dport 3128 accept

    # Includes other sandboxes, metadata/private networks, direct DNS,
    # control-plane services, and direct internet routing.
    iifname "sandbox0" ip saddr 10.99.0.128/25 drop
    iifname "sandbox0" ip6 saddr != :: drop
  }
}

table bridge orcheo_sandbox_bridge {
  chain forward {
    type filter hook forward priority -10; policy accept;

    ether type ip ip saddr 10.99.0.128/25 ip daddr 10.99.0.2 tcp dport 9091 accept
    ether type ip ip saddr 10.99.0.128/25 ip daddr 10.99.0.3 tcp dport 3128 accept
    ether type ip ip saddr 10.99.0.128/25 drop
    ether type ip6 drop
  }
}
