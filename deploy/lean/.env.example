# -----------------------------------------------------------------------------
# Orcheo Lean Stack Environment Template
#
# Copy to .env next to docker-compose.yml. Compose reads it for variable
# substitution, and the backend, worker, and Beat containers load it too.
# `orcheo install --lean` copies it to ~/.orcheo/lean/.env and generates the
# secrets below on a fresh install.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
# Published lean image; `orcheo install --lean` pins it to the installed
# release. Leave unset to build Dockerfile.lean from a source checkout.
# ORCHEO_LEAN_IMAGE=ghcr.io/ai-colleagues/orcheo-lean:0.1.0

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------
# 64-hex key used by the vault to encrypt credentials at rest.
ORCHEO_VAULT_ENCRYPTION_KEY=replace-with-64-hex-chars
# HMAC signing key used to mint/verify ChatKit access tokens.
ORCHEO_CHATKIT_TOKEN_SIGNING_KEY=strong-random-secret
# Signing secret for first-party HS256 access tokens; required (for example
# `openssl rand -hex 32`). `orcheo install --lean` generates it.
ORCHEO_AUTH_JWT_SECRET=
# Bootstrap service token accepted by the backend (CLI/SDK access).
ORCHEO_AUTH_BOOTSTRAP_SERVICE_TOKEN=change-me

# -----------------------------------------------------------------------------
# Browser-facing origin and ports
# -----------------------------------------------------------------------------
# Origin the browser uses for Studio and the API (magic links, CORS).
ORCHEO_LEAN_PUBLIC_URL=http://localhost:2025
# Host port bound on 127.0.0.1 for the backend and bundled Studio.
ORCHEO_LEAN_PORT=2025

# -----------------------------------------------------------------------------
# Database (Supabase)
# -----------------------------------------------------------------------------
# PostgreSQL is not bundled. Use a Supabase connection string from the
# project's Connect dialog. Prefer the transaction pooler (Supavisor,
# *.pooler.supabase.com port 6543): it is reachable over IPv4 and shares a few
# server connections across the backend and every worker process. The session
# pooler (port 5432) holds one server connection per client and fails with
# EMAXCONNSESSION once its pool size (15 on small projects) is used up. The
# direct connection and dedicated pooler (db.<ref>.supabase.co) are IPv6-only;
# they need a host with outbound IPv6 and ORCHEO_LEAN_ENABLE_IPV6=true.
# Keep the DSN single-quoted so `$` and `#` in the password are not
# interpolated, and URL-encode a `'`.
ORCHEO_POSTGRES_DSN=
# Give the containers an IPv6 route (needs Docker Engine 27+). Set to false on
# older engines; Supavisor pooler strings work over IPv4 either way.
ORCHEO_LEAN_ENABLE_IPV6=true
# Per-process connection pool bounds. Each backend, worker, and Beat process
# holds up to five pools; lower the maximum on a session-mode pooler.
ORCHEO_POSTGRES_POOL_MIN_SIZE=1
ORCHEO_POSTGRES_POOL_MAX_SIZE=10
ORCHEO_POSTGRES_POOL_TIMEOUT=5
ORCHEO_POSTGRES_POOL_MAX_IDLE=240
ORCHEO_POSTGRES_CONNECT_TIMEOUT=10
ORCHEO_POSTGRES_KEEPALIVES_IDLE=30
ORCHEO_POSTGRES_KEEPALIVES_INTERVAL=10
ORCHEO_POSTGRES_KEEPALIVES_COUNT=3
ORCHEO_POSTGRES_TCP_USER_TIMEOUT_MS=30000
ORCHEO_IDENTITY_POSTGRES_STATEMENT_TIMEOUT_MS=10000
ORCHEO_IDENTITY_POSTGRES_LOCK_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# Authentication (first-party passwordless email IdP)
# -----------------------------------------------------------------------------
# The lean stack listens on localhost only, so the local defaults skip the
# login gate. `orcheo install --lean` switches to ORCHEO_AUTH_MODE=required and
# VITE_ORCHEO_AUTH_DISABLED=false when ORCHEO_LEAN_PUBLIC_URL uses https://; set
# them yourself for any other publicly reachable deployment, and configure SMTP
# below so sign-in links are emailed.
ORCHEO_AUTH_MODE=disabled
VITE_ORCHEO_AUTH_DISABLED=true
ORCHEO_AUTH_ISSUER=https://auth.orcheo.cloud
ORCHEO_AUTH_AUDIENCE=orcheo-api
# Comma-separated email domains allowed to sign in (exact match, so list
# subdomains separately). Leave blank to allow any domain.
ORCHEO_AUTH_ALLOWED_EMAIL_DOMAINS=

# -----------------------------------------------------------------------------
# Workflow uploads
# -----------------------------------------------------------------------------
# Local installs let the operator upload workflows from the CLI/SDK. Use
# `managed` (or `restricted` definition mode) for multi-tenant deployments.
ORCHEO_WORKFLOW_TRUST_MODE=allow_client_uploads
ORCHEO_WORKFLOW_DEFINITION_MODE=unrestricted

# -----------------------------------------------------------------------------
# Coding-agent CLIs (CodexNode, ClaudeCodeNode, AntigravityNode)
# -----------------------------------------------------------------------------
# The image ships codex, claude, and agy; the worker runs them. Either set the
# headless credentials below, or log in once inside the worker as the runtime
# user (e.g. `docker compose exec -u orcheo worker codex login --device-auth`);
# logins persist on the /data volume.
# Long-lived Claude Code token from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# API key for `codex exec`.
# CODEX_API_KEY=
# Gemini API key for agy; also set "modelProvider": "gemini" in
# /data/home/.gemini/antigravity-cli/settings.json inside the containers.
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Transactional email (SMTP) — sign-in links/codes and workspace invites
# -----------------------------------------------------------------------------
# Leave ORCHEO_SMTP_HOST blank to log links/codes to the backend logs instead.
ORCHEO_SMTP_HOST=
ORCHEO_SMTP_PORT=587
ORCHEO_SMTP_USERNAME=
ORCHEO_SMTP_PASSWORD=
ORCHEO_SMTP_FROM_EMAIL=no-reply@orcheo.cloud
ORCHEO_SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Studio
# -----------------------------------------------------------------------------
# Public ChatKit domain key shipped to browsers; set it to enable ChatKit UI.
VITE_ORCHEO_CHATKIT_DOMAIN_KEY=domain_pk_replace_me
