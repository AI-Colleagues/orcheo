{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orcheo",
  "version": "0.1.4",
  "identifier": "com.orcheo.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orcheo",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "url": "index.html",
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle/orcheo": "orcheo",
      "../bundle/postgres": "postgres",
      "../../../studio/dist": "studio"
    }
  }
}
