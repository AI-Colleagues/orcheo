{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orcheo Desktop",
  "version": "0.1.0",
  "identifier": "com.orcheo.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orcheo",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle/orcheo": "orcheo",
      "../bundle/postgres": "postgres",
      "../bundle/ms-playwright": "ms-playwright",
      "../../../studio/dist": "studio"
    }
  }
}
